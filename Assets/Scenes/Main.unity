  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 0.96, b: 0.86, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 0990ec393e306a74ba15bfed48efe450, type: 3}
    m_FontSize: 48
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 48
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: 'A / D  -  Walk. Your tool bag comes with you.


    Hold SHIFT  -  Plant
    your feet so the bag can''t drag you.


    SHIFT + A / D  -  Swing the bag.
    Push with the swing to make it bigger.


    SPACE  -  Jump. Jump as the bag
    swings UP to launch way higher.



    GOAL  -  Climb to the top of the toilet
    and flush the clog away.


    Fall down a pit and you go back to the last flag.


    Make
    it to the top of the toilet and get flushed!


