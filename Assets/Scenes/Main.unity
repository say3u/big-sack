  m_FontData:
    m_Font: {fileID: 12800000, guid: 0990ec393e306a74ba15bfed48efe450, type: 3}
    m_FontSize: 44
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 3
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: 'A / D  -  Walk. Your sack is heavy and drags behind you.

    Hold SHIFT 
    -  Brace your feet so the sack can''t pull you.

    SHIFT + A / D  -  Push the
    sack to swing it. Push with the swing to build it up!

    SPACE  -  Jump. Jump
    as the sack swings UP to launch way farther.


    Sandy islands crumble after
    you stand on them.

    Flags are checkpoints. Hit the ground and you go back
    to the last one.

    ESC  -  Pause'
